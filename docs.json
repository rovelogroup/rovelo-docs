{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Rovelo Docs",
  "colors": {
    "primary": "#DC1F57",
    "light": "#FF6895",
    "dark": "#AF1E49"
  },
  "favicon": {
    "light": "/images/Favicon.svg",
    "dark": "/images/Favicon.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "introduction",
          "quickstart"
        ],
        "icon": "rocket"
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Updates",
          "icon": "git-commit-horizontal",
          "href": "https://feedback.rovelo.app/updates"
        },
        {
          "anchor": "Untitled Anchor",
          "href": ""
        }
      ],
      "tabs": [
        {
          "tab": "Untitled Tab",
          "href": ""
        }
      ]
    }
  },
  "logo": {
    "light": "/images/Light.svg",
    "dark": "/images/Light.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://discord.gg/axkFhRFhth"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Rovelo",
      "href": "https://app.rovelo.app"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "download-pdf",
      "chatgpt",
      "claude",
      "grok",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/rovelogroup",
      "github": "https://github.com/rovelogroup"
    }
  },
  "description": "All information regarding the Rovelo platform.",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "icons": {
    "library": "lucide"
  }
}
